DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-local-antes-de-publicar
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,sigee-psi.vercel.app
SIGEE_CONTATO_PRIVACIDADE=suporte.sigee@gmail.com

# Em desenvolvimento, a ausência destas variáveis exibe o e-mail no console.
# Em produção, o SIGEE usa Gmail SMTP com uma senha de app armazenada somente
# nas variáveis protegidas da hospedagem. Nunca versione a credencial real.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_HOST_USER=conta-do-sigee@gmail.com
# DJANGO_EMAIL_HOST_PASSWORD=senha-de-app-gerada-no-google
# DJANGO_DEFAULT_FROM_EMAIL=SIGEE <conta-do-sigee@gmail.com>
# DJANGO_EMAIL_TIMEOUT=10
# DJANGO_PASSWORD_RESET_TIMEOUT=3600

# Cole aqui a URL de conexão do PostgreSQL fornecida pelo Supabase.
# Sem esta variável, o projeto usa SQLite somente para desenvolvimento local.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres?sslmode=require
